# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/

# macOS
.DS_Store

# Editor
.vscode/
*.swp
*.swo

# Temp outputs (consistency checker uses this)
.tmp_gen/

# gen/ is intentionally committed — the deterministic spec→output artifacts
# (rtl/, include/, docs/) are the checked-in baseline for consistency gating.
# Run artifacts (manifest, lint/sim/validate reports, compiled sim binaries)
# are environment-dependent and are NOT committed — CI/local runs regenerate
# them fresh each time.
gen/*_manifest.json
gen/lint_report.json
gen/sim_report.json
gen/validation_report.json
gen/sim/

# Internal documentation
CLAUDE.md
RDL2RTL_PROMPT.md
docs/HANDOFF.md
docs/SPEC.md
docs/sessions/
docs/notes/
